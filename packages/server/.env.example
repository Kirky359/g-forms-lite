DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/forms?schema=public"
PORT=4000
FIREBASE_PROJECT_ID="your-firebase-project-id"
# Paste the full service account JSON as a single-line string (from Firebase Console → Service Accounts)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Comma-separated allowed origins, e.g: http://localhost:3000,https://yourapp.com
ALLOWED_ORIGINS="http://localhost:3000"