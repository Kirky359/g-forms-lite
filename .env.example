# ─── Firebase (required by both client build and server) ───────────────────────
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PROJECT_ID=your-project-id

# ─── Server ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (e.g. https://yourapp.com)
# Leave unset to allow all origins (dev only)
ALLOWED_ORIGINS=http://localhost

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=forms
POSTGRES_PASSWORD=forms_secret
POSTGRES_DB=forms

# ─── App ───────────────────────────────────────────────────────────────────────
# Port the app is exposed on (default: 80)
APP_PORT=80